    "import json\n",
    "\n",
    "def write_seq(seqs, file):\n",
    "    with open(file, 'rw') as fin:\n",
    "        json_string = json.dump(seqs, fin)\n",
    "    \n",
    "def read_seq(file):\n",
    "    with open(file, 'r') as fin:\n",
    "        seqs = json.load(fin)\n",
    "    return seqs"
   ]
